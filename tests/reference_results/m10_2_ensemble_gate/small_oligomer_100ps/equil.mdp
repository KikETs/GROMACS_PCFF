
integrator  = md
dt          = 0.001
nsteps      = 5000
cutoff-scheme = Verlet
vdw-type     = Cut-off
rvdw         = 1.2
coulombtype  = PME
rcoulomb     = 1.2
pbc          = xyz
nstxout      = 0
nstvout      = 0
nstfout      = 0
nstenergy    = 100
tcoupl      = v-rescale
tc-grps     = System
tau-t       = 0.1
ref-t       = 300
gen-vel     = yes
gen-temp    = 300
pcoupl      = Berendsen
pcoupltype  = isotropic
tau-p       = 1.0
compressibility = 4.5e-5
ref-p       = 1.0
