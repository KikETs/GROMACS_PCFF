
integrator  = md
dt          = 0.001
nsteps      = 100
cutoff-scheme = Verlet
vdw-type     = Cut-off
rvdw         = 0.9
coulombtype  = PME
rcoulomb     = 0.9
pbc          = xyz
nstxout      = 10
nstvout      = 0
nstfout      = 0
nstenergy    = 10

tcoupl      = v-rescale
tc-grps     = System
tau-t       = 0.1
ref-t       = 300
gen-vel     = yes
gen-temp    = 300
