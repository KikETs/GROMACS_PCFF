integrator = md-vv
dt = 0.001
nsteps = 20000
cutoff-scheme = Verlet
nstlist = 10
verlet-buffer-tolerance = -1
rlist = 0.9
coulombtype = PME
coulomb-modifier = none
rcoulomb = 0.9
pme-order = 4
fourierspacing = 0.12
ewald-rtol = 1e-5
vdw-type = Cut-off
vdw-modifier = none
rvdw = 0.9
DispCorr = no
pbc = xyz
nstenergy = 100
nstlog = 100
nstxout-compressed = 0
tcoupl = nose-hoover
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = MTTK
pcoupltype = isotropic
tau-p = 5.0
compressibility = 4.5e-05
ref-p = 200.0
gen-vel = no
continuation = yes
constraints = none
