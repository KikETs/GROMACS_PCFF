integrator = md
dt = 0.001
nsteps = 20000
cutoff-scheme = Verlet
nstlist = 10
coulombtype = PME
coulomb-modifier = none
rcoulomb = 0.9
pme-order = 4
fourierspacing = 0.12
ewald-rtol = 1e-5
vdw-type = Cut-off
vdw-modifier = none
rvdw = 0.9
DispCorr = no
pbc = xyz
nstenergy = 100
nstlog = 100
nstxout-compressed = 0
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = no
gen-vel = no
continuation = yes
constraints = none
