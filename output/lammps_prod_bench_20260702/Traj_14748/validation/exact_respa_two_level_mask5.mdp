title                     = Traj_14748 two-level exact r-RESPA GPU mask-5 validation
integrator                = md-vv
dt                        = 0.0005
nsteps                    = 8

exact-respa               = yes
exact-respa-levels        = 2
exact-respa-level1-factor = 1
exact-respa-level2-factor = 4
exact-respa-bond-level    = 1
exact-respa-angle-level   = 1
exact-respa-dihedral-level = 1
exact-respa-improper-level = 1
exact-respa-pair14-level  = 1
exact-respa-pair-level    = 2
exact-respa-kspace-level  = 2
exact-respa-inner-level   = 1
exact-respa-middle-level  = 0
exact-respa-outer-level   = 2
exact-respa-inner-off     = 0
exact-respa-inner-on      = 0
exact-respa-outer-on      = 0.60
exact-respa-outer-off     = 0.90

cutoff-scheme             = Verlet
nstlist                   = 4
pbc                       = xyz
verlet-buffer-tolerance   = -1
rlist                     = 1.25

coulombtype               = PME
coulomb-modifier          = none
rcoulomb                  = 0.95
vdwtype                   = Cut-off
vdw-modifier              = none
rvdw                      = 0.95
DispCorr                  = No
fourierspacing            = 0.08
pme-order                 = 4
ewald-rtol                = 0.0001

tcoupl                    = no
pcoupl                    = no
constraints               = none
comm-mode                 = none
continuation              = no
gen-vel                   = yes
gen-temp                  = 353
gen-seed                  = 14748

nstxout                   = 0
nstvout                   = 0
nstfout                   = 0
nstlog                    = 0
nstcalcenergy             = 500000
nstenergy                 = 0
nstxout-compressed        = 0
