title                    = Traj_14748 LAMMPS prod-start native NVE benchmark
integrator               = md-vv
dt                       = 0.002
nsteps                   = 5000

cutoff-scheme            = Verlet
nstlist                  = 4
pbc                      = xyz
verlet-buffer-tolerance  = -1
rlist                    = 1.25

coulombtype              = PME
coulomb-modifier         = none
rcoulomb                 = 0.95
vdwtype                  = Cut-off
vdw-modifier             = none
rvdw                     = 0.95
DispCorr                 = No
fourierspacing           = 0.08
pme-order                = 4
ewald-rtol               = 0.0001

tcoupl                   = no
pcoupl                   = no
constraints              = none
comm-mode                = none
continuation             = no
gen-vel                  = yes
gen-temp                 = 353
gen-seed                 = 14748

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 0
nstcalcenergy            = 500000
nstenergy                = 0
nstxout-compressed       = 0
