integrator = md
nsteps = 1000
dt = 0.001
cutoff-scheme = Verlet
nstlist = 1
rlist = 0.909
verlet-buffer-tolerance = -1
nstcalcenergy = 1
nstenergy = 1
nstlog = 100
nstfout = 1
nstxout = 0
nstvout = 0
nstxout-compressed = 0
coulombtype = Cut-off
coulomb-modifier = Potential-shift
rcoulomb = 0.9
vdw-type = Cut-off
vdw-modifier = Potential-shift
rvdw = 0.9
pbc = xyz
tcoupl = no
pcoupl = no
constraints = none
comm-mode = Linear
nstcomm = 100
gen_vel = yes
gen-temp = 300
gen-seed = 12345
